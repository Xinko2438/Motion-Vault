    "code": " case'string':label='稍作牵引 / 然后松开';figure=`<svg class=\"x-svg x-string\" viewBox=\"0 0 400 260\" aria-label=\"可拖动的弹性线条\" tabindex=\"0\"><text x=\"200\" y=\"56\" text-anchor=\"middle\">一点张力。</text>${[0,1,2].map(i=>`<path class=\"x-string-line\" d=\"M36 ${125+i*17}Q200 ${125+i*17} 364 ${125+i*17}\" fill=\"none\" stroke=\"${['#345e4c','#86a28d','#becbbc'][i]}\" stroke-width=\"${i===0?2:1}\"/>`).join('')}<circle cx=\"36\" cy=\"125\" r=\"3\" fill=\"#345e4c\"/><circle cx=\"364\" cy=\"125\" r=\"3\" fill=\"#345e4c\"/><text x=\"200\" y=\"222\" text-anchor=\"middle\">拖动线条，观察恢复。</text></svg>`;break;",
