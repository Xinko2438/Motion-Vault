  "runtimeControls": {
    "SourceDemo.stop()": "Pause render loop and active gesture where applicable.",
    "SourceDemo.resume()": "Resume only local rendering; never fabricate input.",
    "SourceDemo.dispose()": "Dispose this mounted effect and local resource transport.",
    "SourceDemo.paint()": "Read readiness; lenticular also invalidates its demand frame. No synthetic motion."
