      "unit": "world units",
      "binding": "Experience.useControls.height (0.001..0.2)",
      "editIn": "adapter/author; preserve immutable source snapshot",
      "runtimeMutationExposed": true
    },
    {
      "name": "planeSize",
      "default": [
        1,
        1
      ],
      "unit": "world units",
      "binding": "planeGeometry args",
      "editIn": "adapter/author; preserve immutable source snapshot",
      "runtimeMutationExposed": true
    },
    {
      "name": "widthSegments",
      "default": "nbDivisions * 2",
      "unit": "segments",
      "binding": "planeGeometry args",
      "editIn": "adapter/author; preserve immutable source snapshot",
      "runtimeMutationExposed": true
    },
    {
