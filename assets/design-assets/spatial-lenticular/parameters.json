      "editIn": "adapter/author; preserve immutable source snapshot",
      "runtimeMutationExposed": true
    },
    {
      "name": "background",
      "default": "#333",
      "unit": "color",
      "binding": "App.color",
      "editIn": "adapter/author; preserve immutable source snapshot",
      "runtimeMutationExposed": true
    },
    {
      "name": "rendererBackend",
      "default": "WebGL",
      "unit": "backend",
      "binding": "WebGPURenderer.forceWebGL",
      "editIn": "adapter/author; preserve immutable source snapshot",
      "runtimeMutationExposed": true
    },
    {
      "name": "maxDpr",
